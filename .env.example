# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Nhà cung cấp AI: gemini | fake
AI_PROVIDER=fake

# Khoá API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Danh sách model theo thứ tự ưu tiên, cách nhau bởi dấu phẩy. Hết lượt model đầu thì hệ
# thống tự xoay sang model kế. Kiểm 17/09: gemini-2.0-flash (P0) và gemini-2.5-flash (13/09)
# đều đã đóng với người dùng mới.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite

# Ước tính hạn mức gói miễn phí. Con số thật được học lại khi Google trả lỗi 429.
GEMINI_RPD_UOC_TINH=20
GEMINI_RPM_UOC_TINH=5

# Token "suy nghĩ" mỗi lời gọi. 0 = tắt (đo 18/09: 2,2s thay vì 5,9-10,2s, câu trả lời vẫn
# đúng mực). Đặt -1 để dùng mặc định của model.
GEMINI_THINKING_BUDGET=0

# Ngân sách thời gian cho MỘT lần người dùng bấm: tổng cả chuỗi model đã thử, và tối đa cho
# từng lần thử. Không có tổng thì bốn model quá tải nối nhau treo trang vài phút.
AI_TONG_GIAY=45
AI_MOI_LAN_GIAY=25

# Model vừa quá tải (503) hoặc chạm giới hạn phút thì nghỉ bấy nhiêu giây rồi mới thử lại.
AI_NGHI_GIAY=120

# Cơ sở dữ liệu
DATABASE_URL=sqlite:///./petcare.db

# Khoá ký session cookie
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-truoc-khi-chay-that

# Số vòng băm bcrypt. Giữ 12 khi chạy thật; bộ test tự hạ xuống 4 cho nhanh.
BCRYPT_ROUNDS=12
